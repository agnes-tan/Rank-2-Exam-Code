#include <unistd.h>

int main(int ac, char **av)
{
    int i;
    int last;

    last = ac - 1;
    

    if (ac == 1)
    {
        write(1, "\n", 1);
        return (0);
    }
    while (ac > 1)
    {
        i = 0;
        while (av[last][i])
        {
            write(1, &av[last][i], 1);
            i++;
        }
        write(1, "\n", 1);
        return (0);
    }
}


#include <unistd.h>

int	main(int ac, char **av)
{
	int	i;
	int	last;	

	last = ac -1;
	while (last > 0)
	{
		i = 0;
		while (av[last][i] != '\0')
		{
			write(1, &av[last][i], 1);
			i++;
		}
		write(1, "\n", 1);
		last--;
	}
	return (0);
}
